<resources>
    <declare-styleable name="MediaItemView">
        <attr name="elevation" />
        <attr name="android:textColor" />
        <attr name="iconColor" format="color|reference" />
        <attr name="hintColor" format="color|reference" />
        <attr name="titleTextAppearance" format="reference" />
        <attr name="subtitleTextAppearance" format="reference" />
        <!-- Optional, used by the Modern theme. The defaults keep the original look -->
        <attr name="mediaItemSubtitleColor" format="color|reference" />
        <attr name="mediaItemIconAspectRatio" format="float" />
        <attr name="mediaItemIconCornerRadius" format="dimension" />
        <attr name="mediaItemIconExtraSize" format="dimension" />
        <attr name="mediaItemIconBackground" format="reference" />
        <attr name="mediaItemBoldTitle" format="boolean" />
        <attr name="mediaItemDefaultCover" format="reference" />
    </declare-styleable>

    <declare-styleable name="ControlPanelView">
        <attr name="size" />
        <attr name="textAppearance" />
        <attr name="android:colorBackground" />
        <!-- Optional drawable used instead of the plain background color -->
        <attr name="controlPanelBackground" format="reference" />
        <!-- Optional, used by the Modern theme: pills behind the playback buttons -->
        <attr name="controlPanelButtonBackground" format="reference" />
        <attr name="controlPanelPlayBackground" format="reference" />
        <attr name="controlPanelPlayTint" format="color|reference" />
        <!-- The icon height relative to the button height, 0 keeps the icon filling the button -->
        <attr name="controlPanelIconScale" format="float" />
    </declare-styleable>
</resources>