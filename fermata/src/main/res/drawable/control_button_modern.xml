<?xml version="1.0" encoding="UTF-8"?>

<!-- A translucent pill behind the playback buttons, so it reads over any picture.
     The button is a fifth of the panel wide, the pill keeps a fixed width in its center -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/rippleColor">
    <item
        android:id="@android:id/mask"
        android:bottom="2dp"
        android:gravity="center"
        android:top="2dp"
        android:width="56dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/rippleColor" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <item
        android:id="@android:id/background"
        android:bottom="2dp"
        android:gravity="center"
        android:top="2dp"
        android:width="56dp">
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="#338AB4F8" />
                    <stroke
                        android:width="?attr/boxStrokeWidth"
                        android:color="?attr/colorAccent" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1FFFFFFF" />
                    <corners android:radius="999dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
