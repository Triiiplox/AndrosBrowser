<?xml version="1.0" encoding="utf-8"?>
<!-- The top of the details page of a movie or a series -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/xtream_backdrop_height">

        <ImageView
            android:id="@+id/xtream_details_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/xtream_scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/xtream_scrim_bottom" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="@dimen/xtream_gutter"
            android:paddingEnd="@dimen/xtream_gutter">

            <ImageView
                android:id="@+id/xtream_details_poster"
                android:layout_width="@dimen/xtream_details_poster_width"
                android:layout_height="@dimen/xtream_details_poster_height"
                android:layout_marginEnd="14dp"
                android:background="@drawable/xtream_card_bg"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/xtream_details_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#CC000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/xtream_details_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#D0D5DD"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Last: drawn over the poster, never under it -->
        <ImageButton
            android:id="@+id/xtream_details_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="10dp"
            android:background="@drawable/xtream_round_button"
            android:contentDescription="@string/xtream_home"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/xtream_back" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/xtream_gutter"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/xtream_gutter">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/xtream_details_play"
                layout="@layout/xtream_button_play" />

            <include
                android:id="@+id/xtream_details_list"
                layout="@layout/xtream_button_tonal" />

            <include
                android:id="@+id/xtream_details_restart"
                layout="@layout/xtream_button_tonal"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/xtream_details_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/xtream_progress"
            android:visibility="gone" />

        <TextView
            android:id="@+id/xtream_details_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/xtream_details_credits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/xtream_details_loading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/xtream_details_episodes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/xtream_episodes"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/xtream_details_seasons_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/xtream_details_seasons"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/xtream_gutter"
            android:paddingEnd="@dimen/xtream_gutter" />
    </HorizontalScrollView>
</LinearLayout>
