<?xml version="1.0" encoding="utf-8"?>
<!-- Indeterminate progress: the emblem fills from left to right (the progress bar animates the level) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:alpha="0.3"
            android:gravity="fill"
            android:src="@drawable/logo_emblem" />
    </item>
    <item>
        <clip
            android:clipOrientation="horizontal"
            android:drawable="@drawable/logo_emblem"
            android:gravity="left" />
    </item>
</layer-list>
