<?xml version="1.0" encoding="UTF-8"?>

<!-- A tonal surface, a bit lighter than the window. The hairline keeps the edge visible,
     the shadow is barely seen on the dark window -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1A1F27" />
    <stroke
        android:width="1dp"
        android:color="#2A313C" />
    <corners android:radius="16dp" />
</shape>
