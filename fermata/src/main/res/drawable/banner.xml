<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180dp): the emblem on the app icon background -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp">
    <item android:drawable="@drawable/logo_bg" />
    <item
        android:width="150dp"
        android:height="111dp"
        android:drawable="@drawable/logo_emblem"
        android:gravity="center" />
</layer-list>
